# Vercel CLI (agent deploy from Cursor — never commit the real token)
VERCEL_TOKEN=

# Product web app — same domain (set in Vercel Production; server-only, no NEXT_PUBLIC_)
# Example: https://your-iron-compass-frontend.vercel.app
PRODUCT_APP_UPSTREAM_URL=

# Or send "Open App" to a subdomain instead of /app (optional)
# NEXT_PUBLIC_PRODUCT_APP_URL=https://app.ironcompass.app

# Contact form delivery. Server-only. Do not put the inbox address in page code.
# Point this at a private webhook that forwards to the operational inbox.
CONTACT_WEBHOOK_URL=

# Email capture — use one provider
# Generic webhook (ConvertKit, Formspree, Zapier, etc.)
SUBSCRIBE_WEBHOOK_URL=

# Or Resend audience contacts
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# App store links (shown on /download when set)
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# Free starter-pack funnel. Disabled until a verified sending account and tested,
# durably idempotent double-opt-in/suppression workflow are ready. Never use app DB.
PACK_CAMPAIGN_ENABLED=false
PACK_CAMPAIGN_PROVIDER_NAME=
PACK_CAMPAIGN_WEBHOOK_URL=
PACK_CAMPAIGN_SIGNING_SECRET=
PACK_CAMPAIGN_VERIFIED_AT=

# Durable adapter: free Redis account, isolated campaign namespace, no app DB.
# Keep disabled until preview acceptance and explicit release approval.
PACK_CAMPAIGN_ADAPTER=durable
UPSTASH_REST_URL=
UPSTASH_REST_TOKEN=
PACK_TOKEN_SECRET=
PACK_NAMESPACE=
PACK_STORE_EPOCH=
PACK_RESEND_DOMAIN_ID=
PACK_RESEND_WEBHOOK_SECRET=
PACK_PUBLIC_ORIGIN=
PACK_DELIVERY_MODE=test
PACK_TEST_RECIPIENT=
PACK_LIVE_APPROVED=false
CRON_SECRET=

# Optional GA4 pack-only measurement, loaded only after visitor opt-in.
# Use a separate test property in preview; disable Enhanced Measurement in GA4.
NEXT_PUBLIC_PACK_GA4_ID=
NEXT_PUBLIC_PACK_EXPERIMENT_ENABLED=false
