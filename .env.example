# Vercel CLI (agent deploy from Cursor — never commit the real token)
VERCEL_TOKEN=

# Product web app — same domain (set in Vercel Production; server-only, no NEXT_PUBLIC_)
# Example: https://your-iron-compass-frontend.vercel.app
PRODUCT_APP_UPSTREAM_URL=

# Or send "Open App" to a subdomain instead of /app (optional)
# NEXT_PUBLIC_PRODUCT_APP_URL=https://app.ironcompass.app

# Email capture — use one provider
# Generic webhook (ConvertKit, Formspree, Zapier, etc.)
SUBSCRIBE_WEBHOOK_URL=

# Or Resend audience contacts
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# App store links (shown on /download when set)
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
